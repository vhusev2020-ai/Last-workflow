{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCorp Genesis Agent Record",
  "type": "object",
  "required": ["id", "name", "version", "status", "parent_agent_id", "project_id", "mission", "authority_level", "permissions", "limits", "acceptance_criteria"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 2, "maxLength": 80},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum": ["draft", "testing", "approved", "active", "paused", "retired"]},
    "parent_agent_id": {"type": ["string", "null"]},
    "project_id": {"type": "string"},
    "mission": {"type": "string", "minLength": 10},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "authority_level": {"enum": ["L0", "L1", "L2", "L3", "L4-human-reserved"]},
    "permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "denied_actions": {"type": "array", "items": {"type": "string"}},
    "limits": {
      "type": "object",
      "required": ["max_child_agents", "max_depth", "max_concurrent_tasks", "max_runtime_minutes"],
      "properties": {
        "max_child_agents": {"type": "integer", "minimum": 0, "maximum": 20},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 5},
        "max_concurrent_tasks": {"type": "integer", "minimum": 1, "maximum": 50},
        "max_runtime_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "spend_limit_usd": {"const": 0},
        "external_actions_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification_method": {"type": "string"},
    "data_classification": {"enum": ["public", "project", "restricted", "personal-sensitive", "secrets"]},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string"},
    "approved_by": {"type": ["string", "null"]},
    "audit_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}